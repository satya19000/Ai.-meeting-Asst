# ═══════════════════════════════════════════════════
#  backend/Dockerfile  —  Node.js API
# ═══════════════════════════════════════════════════
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache dumb-init wget

# Dependencies
FROM base AS deps
COPY package*.json ./
RUN npm ci --omit=dev

# Build (nothing to compile for pure JS, but future-proofed)
FROM base AS build
COPY package*.json ./
RUN npm ci
COPY src/ ./src/

# Production
FROM base AS production
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/src ./src
COPY package.json ./

RUN mkdir -p recordings uploads logs

EXPOSE 4000
USER node
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "src/app.js"]
